@page "/accounts/plaid"
@rendermode InteractiveServer

<PageTitle>Bank Connections</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    <div class="container" style="max-width: 760px;">
        <div class="d-flex align-items-center mt-3 mb-3">
            <h1 class="mb-0">Bank connections</h1>
            <RadzenButton Text="Reconciliation inbox" Icon="fact_check" ButtonStyle="ButtonStyle.Light" class="ms-auto me-2" Click="OpenReconciliationInbox" />
            <RadzenButton Text="Back to accounts" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="BackToAccounts" />
        </div>
        <p class="text-muted">Connect a bank with Plaid, then explicitly map each bank account to a Budget account. This setup never imports or changes checkbook transactions.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <RadzenCard class="mb-3">
            <h5>Connect an institution</h5>
            <p class="mb-2">Use the secure Plaid Link flow to choose an institution. Plaid credentials remain on the server.</p>
            <RadzenButton Text="Start secure connection" Icon="link" ButtonStyle="ButtonStyle.Primary" Click="StartConnectionAsync" />
        </RadzenCard>

        @if (items.Count == 0)
        {
            <p class="text-muted">No institutions are connected.</p>
        }
        else
        {
            @foreach (var item in items)
            {
                <RadzenCard class="mb-2">
                    <div class="d-flex align-items-center">
                        <div><strong>@item.InstitutionName</strong><br /><small class="text-muted">@item.MappingCount mapped account(s) · @item.Status</small></div>
                        <RadzenButton Text="Map accounts" Icon="account_tree" ButtonStyle="ButtonStyle.Light" class="ms-auto me-2" Click="() => ShowAccountsAsync(item.PlaidItemId)" />
                        <RadzenButton Text="Update connection" Icon="refresh" ButtonStyle="ButtonStyle.Light" class="me-2" Click="() => StartUpdateConnectionAsync(item.PlaidItemId)" />
                        <RadzenButton Text="Disconnect" Icon="link_off" ButtonStyle="ButtonStyle.Danger" Click="() => DisconnectAsync(item.PlaidItemId)" />
                    </div>
                    @if (selectedPlaidItemId == item.PlaidItemId)
                    {
                        <div class="mt-3 border-top pt-3">
                            <h6>Map discovered accounts</h6>
                            @if (discoveredAccounts.Count == 0)
                            {
                                <p class="text-muted mb-0">No accounts were returned by this institution.</p>
                            }
                            else
                            {
                                @foreach (var account in discoveredAccounts)
                                {
                                    <div class="row align-items-center mb-2" @key="account.PlaidAccountId">
                                        <div class="col-md-5"><strong>@account.Name</strong> <small class="text-muted">@(string.IsNullOrEmpty(account.Mask) ? account.Subtype : $"••{account.Mask}")</small></div>
                                        <div class="col-md-5">
                                            <select class="form-select" value="@GetSelectedBudgetAccount(account.PlaidAccountId)" @onchange="args => SelectBudgetAccount(account.PlaidAccountId, args.Value?.ToString())">
                                                <option value="">Choose a Budget account</option>
                                                @foreach (var budgetAccount in manageableBudgetAccounts)
                                                {
                                                    <option value="@budgetAccount.AccountId">@budgetAccount.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2 mt-1 mt-md-0">
                                            <RadzenButton Text="Save" Size="ButtonSize.Small" Disabled="@(GetSelectedBudgetAccountId(account.PlaidAccountId) is null)" Click="() => MapAccountAsync(account.PlaidAccountId)" />
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </RadzenCard>
            }
        }
    </div>
}
