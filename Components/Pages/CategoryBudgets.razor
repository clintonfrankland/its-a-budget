@page "/category-budgets"
@using ClintonFrankland.Models.ViewModels
@rendermode InteractiveServer

<PageTitle>Category Budgets</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="container">
        <div class="row align-items-center gy-2">
            <div class="col-auto">
                <h1>Category Budgets</h1>
            </div>
            <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                <label class="form-label mb-0 me-2" for="categoryBudgetMonth">Month</label>
                <input id="categoryBudgetMonth"
                       class="form-control d-inline-block"
                       style="width: 170px;"
                       type="month"
                       value="@SelectedMonthInput"
                       @onchange="OnSelectedMonthChangedAsync" />
            </div>
        </div>
    </div>

    <div class="container mt-3">
        <div class="alert alert-info py-2 mb-3">
            Showing category budget status for <strong>@SelectedMonthLabel</strong>.
            Warning starts at <strong>@CategoryBudgetData.Thresholds.WarningPercent%</strong> of a target.
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <RadzenCard class="h-100">
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">@(editTargetId.HasValue ? "Edit Target" : "Add Target")</RadzenText>

                    @if (!string.IsNullOrEmpty(editErrorMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
                                     AllowClose="true" Close="@(() => editErrorMessage = string.Empty)" class="mb-3">
                            @editErrorMessage
                        </RadzenAlert>
                    }

                    @if (writableCategoryOptions.Count == 0)
                    {
                        <p class="text-muted mb-0">Category budget targets are read-only for your current shared-budget role.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label" for="categoryBudgetCategory">Category</label>
                            <RadzenDropDown @bind-Value="editCategoryId" TValue="int" Name="categoryBudgetCategory"
                                            Data="@writableCategoryOptions" TextProperty="CategoryName" ValueProperty="CategoryId"
                                            Style="width: 100%;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="categoryBudgetAmount">Planned amount</label>
                            <RadzenNumeric @bind-Value="editPlannedAmount" TValue="decimal" Name="categoryBudgetAmount"
                                           Format="c2" Min="0" Step="0.01" Style="width: 160px;" />
                        </div>

                        <div class="d-flex gap-2">
                            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanSave)" Click="SaveTargetAsync" />
                            <RadzenButton Text="Clear" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="ResetEditor" />
                        </div>
                    }
                </RadzenCard>
            </div>

            <div class="col-12 col-lg-8">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">Monthly Status</RadzenText>
                    @if (rows.Count == 0)
                    {
                        <p class="text-muted mb-0">No category budgets or spending to show for this month.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Planned</th>
                                        <th class="text-end">Actual</th>
                                        <th class="text-end">Remaining</th>
                                        <th class="text-end">Used</th>
                                        <th>Status</th>
                                        @if (rows.Any(r => r.CanManageFinancialData))
                                        {
                                            <th class="text-end">Actions</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        <tr class="@GetAlertCss(row.AlertStatus)">
                                            <td>@row.CategoryName</td>
                                            <td class="text-end">@row.PlannedAmount.ToString("C")</td>
                                            <td class="text-end">@row.ActualAmount.ToString("C")</td>
                                            <td class="text-end">@row.RemainingAmount.ToString("C")</td>
                                            <td class="text-end">@row.PercentUsed.ToString("0.##")%</td>
                                            <td><span class="badge @GetAlertBadgeCss(row.AlertStatus)">@GetAlertText(row.AlertStatus)</span></td>
                                            @if (rows.Any(r => r.CanManageFinancialData))
                                            {
                                                <td class="text-end">
                                                    @if (row.CanManageFinancialData)
                                                    {
                                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                                      Click="@(() => EditRow(row))" title="Edit" />
                                                    }
                                                    @if (row.CanManageFinancialData && row.TargetId.HasValue)
                                                    {
                                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                                      Click="@(() => DeleteTargetAsync(row))" title="Delete" />
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </RadzenCard>
            </div>
        </div>
    </div>
}
