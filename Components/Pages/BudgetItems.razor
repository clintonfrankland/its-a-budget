@page "/budgetitems"
@using System.Data
@rendermode InteractiveServer

<PageTitle>Budget Items | It's a Budget</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (currentView == ViewMode.List)
    {
        @if (balanceSummary is not null)
        {
            <BalanceBar Balance="balanceSummary.Balance" ClearedBalance="balanceSummary.ClearedBalance"
                        SafeToSpend="balanceSummary.SafeToSpend" SafeToSpendDate="balanceSummary.SafeToSpendDate"
                        MonthlyPlan="balanceSummary.MonthlyPlan" />
        }
        @* Media queries for responsive column visibility - using Bootstrap breakpoints *@
        <RadzenMediaQuery Query="(max-width: 575.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraSmall, matches))" />
        <RadzenMediaQuery Query="(min-width: 576px) and (max-width: 767.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Small, matches))" />
        <RadzenMediaQuery Query="(min-width: 768px) and (max-width: 991.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Medium, matches))" />
        <RadzenMediaQuery Query="(min-width: 992px) and (max-width: 1199.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Large, matches))" />
        <RadzenMediaQuery Query="(min-width: 1200px) and (max-width: 1399.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraLarge, matches))" />
        <RadzenMediaQuery Query="(min-width: 1400px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraExtraLarge, matches))" />

        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto">
                    <h1>Budget Items</h1>
                </div>
                <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                    @if (canCreateFinancialData)
                    {
                        <RadzenButton Icon="add" Text="@(IsAtLeast(ScreenSize.Medium) ? "Add Budget" : "")" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Medium" Click="ShowAddBudgetAsync" />
                    }
                    <RadzenButton Icon="calendar_month" Text="@(IsAtLeast(ScreenSize.Medium) ? "Preview" : "")" ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.Medium" Click="ShowCalendarAsync" class="ms-2" title="Preview upcoming recurring Budget Items" />
                </div>
            </div>
        </div>

        <div class="container mt-4">
            <RadzenDataGrid @ref="budgetItemsGrid" Data="@filteredBudgetItems" TItem="BudgetItemViewModel"
                            Density="Density.Compact"
                            AllowFiltering="true" AllowSorting="true"
                            FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            class="rz-datatable-striped">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" class="mb-2">
                        <RadzenTextBox @bind-Value="@searchText" Placeholder="Search..."
                                       Style="width: 250px;"
                                       @oninput="@(args => OnSearch(args.Value?.ToString()))" />
                        <select class="form-select form-select-sm" style="width: 135px" @bind="kindFilter" aria-label="Budget item kind">
                            <option>All</option>
                            <option>Scheduled</option>
                            <option>Allowances</option>
                        </select>
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <RadzenButton Icon="clear" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => OnSearch(string.Empty))" title="Clear search" />
                        }
                        <RadzenButton Icon="description" Text="CSV" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="ExportCsvAsync" title="Export filtered budget items as CSV" />
                        <RadzenButton Icon="grid_on" Text="Excel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Click="ExportExcelAsync" title="Export filtered budget items as Excel" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    @* Actions column (moveable left/right based on profile setting) *@
                    @if (!AuthService.CurrentUser.ListButtonsRight && filteredBudgetItems.Any(i => i.CanManageFinancialData))
                    {
                        <RadzenDataGridColumn TItem="BudgetItemViewModel" Title="" Width="70px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <BudgetItemActions Page="Budget Items" CanManage="@item.CanManageFinancialData" IsSpendingAllowance="@item.IsSpendingAllowance"
                                    CanRecordToCheckbook="@item.CanRecordToCheckbook" IsInProgress="@IsHandling(item)"
                                    OnRecord="@(() => RecordOccurrenceAsync(item))" OnSkip="@(() => SkipOccurrenceAsync(item))"
                                    OnEdit="@(() => ShowEditBudgetAsync(item.BudgetId))" OnEditNext="@(() => EditNextBudgetItem(item.BudgetId))" />
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Title="" Width="50px" Sortable="false" Filterable="false" TextAlign="TextAlign.Left" Visible="@IsAtLeast(ScreenSize.Large)">
                        <Template Context="item">
                            @if (item.IsBill)
                            {
                                <RadzenIcon Icon="receipt" title="Bill" Style="font-size: 14px; color: var(--rz-danger);" />
                            }
                            @if (item.IsAuto)
                            {
                                <RadzenIcon Icon="schedule" title="Auto Pay" Style="font-size: 14px; color: var(--rz-info);" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="BudgetName" Title="Budget Name" SortOrder="SortOrder.Ascending" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="BehaviorName" Title="Kind" Width="100px" Visible="@IsAtLeast(ScreenSize.Medium)" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="Category" Title="Category" Visible="@IsAtLeast(ScreenSize.Large)" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="DueDate" Title="Due / Reset" Width="105px" FormatString="{0:MM/dd/yyyy}" Visible="@IsAtLeast(ScreenSize.ExtraExtraLarge)" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="EndDateName" Title="End Date" Width="100px" Visible="@IsAtLeast(ScreenSize.ExtraExtraLarge)" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="FrequencyName" Title="Frequency" Width="100px" Visible="@IsAtLeast(ScreenSize.ExtraExtraLarge)" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="Amount" Title="Amount" Width="100px" FormatString="{0:C}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Title="Current" Width="135px" TextAlign="TextAlign.Right" Visible="@IsAtLeast(ScreenSize.Medium)">
                        <Template Context="item">
                            @if (item.IsSpendingAllowance)
                            {
                                <div><strong>@item.RemainingAmount.ToString("C")</strong> left</div>
                                <small class="text-muted">@item.SpentAmount.ToString("C") spent</small>
                            }
                            else
                            {
                                <span class="text-muted">Scheduled</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Property="Monthly" Title="Monthly" Width="100px" FormatString="{0:C}" TextAlign="TextAlign.Right" Visible="@IsAtLeast(ScreenSize.ExtraExtraLarge)">
                        <FooterTemplate>
                            <strong>@filteredBudgetItems.Sum(i => i.Monthly).ToString("C")</strong>
                        </FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="BudgetItemViewModel" Title="3-mo Trend" Width="100px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" Visible="@IsAtLeast(ScreenSize.ExtraExtraLarge)">
                        <HeaderTemplate>
                            <span title="3 complete months of actual spend. Bars are oldest→newest; dashed line is monthly budget.">3-mo Trend</span>
                        </HeaderTemplate>
                        <Template Context="item">
                            @RenderSparkline(item)
                        </Template>
                    </RadzenDataGridColumn>

                    @if (AuthService.CurrentUser.ListButtonsRight && filteredBudgetItems.Any(i => i.CanManageFinancialData))
                    {
                        <RadzenDataGridColumn TItem="BudgetItemViewModel" Title="" Width="70px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <BudgetItemActions Page="Budget Items" CanManage="@item.CanManageFinancialData" IsSpendingAllowance="@item.IsSpendingAllowance"
                                    CanRecordToCheckbook="@item.CanRecordToCheckbook" IsInProgress="@IsHandling(item)"
                                    OnRecord="@(() => RecordOccurrenceAsync(item))" OnSkip="@(() => SkipOccurrenceAsync(item))"
                                    OnEdit="@(() => ShowEditBudgetAsync(item.BudgetId))" OnEditNext="@(() => EditNextBudgetItem(item.BudgetId))" />
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </div>
    }
    else if (currentView == ViewMode.Calendar)
    {
        <RadzenMediaQuery Query="(max-width: 575.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraSmall, matches))" />
        <RadzenMediaQuery Query="(min-width: 576px) and (max-width: 767.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Small, matches))" />
        <RadzenMediaQuery Query="(min-width: 768px) and (max-width: 991.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Medium, matches))" />
        <RadzenMediaQuery Query="(min-width: 992px) and (max-width: 1199.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Large, matches))" />
        <RadzenMediaQuery Query="(min-width: 1200px) and (max-width: 1399.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraLarge, matches))" />
        <RadzenMediaQuery Query="(min-width: 1400px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraExtraLarge, matches))" />

        <div class="container">
            <div class="row align-items-center gy-2">
                <div class="col-auto">
                    <h1>Recurring Preview</h1>
                </div>
                <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                    <RadzenButton Icon="arrow_back" Text="@(IsAtLeast(ScreenSize.Medium) ? "Budget Items" : "")" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Medium" Click="ShowListAsync" title="Return to Budget Items" />
                </div>
            </div>

            <div class="budget-preview-toolbar mt-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" Wrap="FlexWrap.Wrap">
                    <RadzenLabel Text="Window:" Component="previewDaysDropDown" />
                    <RadzenDropDown @bind-Value="previewDays" TValue="int" Name="previewDaysDropDown"
                                    Data="@previewWindowOptions" TextProperty="Text" ValueProperty="Value"
                                    Change="@(args => OnPreviewDaysChangedAsync())"
                                    Style="width: 120px;" />
                    @if (!string.IsNullOrWhiteSpace(previewStatusMessage))
                    {
                        <RadzenText TextStyle="TextStyle.Body2" class="text-success mb-0">@previewStatusMessage</RadzenText>
                    }
                </RadzenStack>
            </div>

            @if (previewItems.Count == 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
                             AllowClose="false" Icon="event_available" class="mt-3">
                    No recurring Budget Items are due in the selected window.
                </RadzenAlert>
            }
            else
            {
                <div class="budget-preview-calendar mt-3">
                    @foreach (var group in previewGroups)
                    {
                        <section class="budget-preview-day" aria-label="Budget Items due @group.Key.ToString("MMMM d, yyyy")">
                            <div class="budget-preview-date">
                                <span class="budget-preview-month">@group.Key.ToString("MMM")</span>
                                <span class="budget-preview-number">@group.Key.Day</span>
                                <span class="budget-preview-weekday">@group.Key.ToString("ddd")</span>
                            </div>
                            <div class="budget-preview-events">
                                @foreach (var item in group)
                                {
                                    <article class="budget-preview-event @(item.IsIncome ? "income" : "expense") @(item.HasCategoryWarning ? "warning" : "")">
                                        <div class="budget-preview-event-main">
                                            <div class="budget-preview-title-row">
                                                <span class="budget-preview-type">@(item.IsIncome ? "Income" : "Expense")</span>
                                                @if (item.IsBill)
                                                {
                                                    <RadzenIcon Icon="receipt" title="Bill" class="budget-preview-icon" />
                                                }
                                                @if (item.IsAuto)
                                                {
                                                    <RadzenIcon Icon="schedule" title="Auto Pay" class="budget-preview-icon" />
                                                }
                                                <strong class="budget-preview-name">@item.BudgetName</strong>
                                                <span class="budget-preview-amount">@item.Amount.ToString("C")</span>
                                            </div>
                                            <div class="budget-preview-meta">
                                                @if (!string.IsNullOrWhiteSpace(item.Payee))
                                                {
                                                    <span>@item.Payee</span>
                                                }
                                                <span>@(string.IsNullOrWhiteSpace(item.Category) ? "No category" : item.Category)</span>
                                                @if (!string.IsNullOrWhiteSpace(item.FrequencyName))
                                                {
                                                    <span>@item.FrequencyName</span>
                                                }
                                            </div>
                                            @if (item.HasCategoryWarning)
                                            {
                                                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                                                             AllowClose="false" Icon="warning" class="budget-preview-warning">
                                                    @item.CategoryWarning
                                                </RadzenAlert>
                                            }
                                        </div>
                                        <div class="budget-preview-actions">
                                            @if (item.CanManageFinancialData)
                                            {
                                                @if (!item.IsSpendingAllowance)
                                                {
                                                <RadzenButton Icon="add_task"
                                                              ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                                              Click="() => RecordOccurrenceAsync(item)"
                                                              Disabled="@(!item.CanRecordToCheckbook || IsHandling(item))"
                                                              title="Record this occurrence to Checkbook" />
                                                <RadzenButton Icon="skip_next"
                                                              ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                                              Click="() => SkipOccurrenceAsync(item)"
                                                              Disabled="@IsHandling(item)"
                                                              title="Skip this occurrence without creating a transaction" />
                                                }
                                                <RadzenButton Icon="edit"
                                                              ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                              Click="() => ShowEditBudgetAsync(item.BudgetId)"
                                                              title="Edit Budget Item or category" />
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </div>
    }
    else if (currentView == ViewMode.Edit)
    {
        <div class="container" style="max-width: 550px;">
            <RadzenCard class="mt-3">
                <h4 class="mb-3">@(editBudgetId == -1 ? "Add" : "Edit") Budget Item</h4>

                @if (!string.IsNullOrEmpty(editErrorMessage))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
                                 AllowClose="true" Close="@(() => editErrorMessage = string.Empty)" class="mb-3">
                        @editErrorMessage
                    </RadzenAlert>
                }

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Behavior:" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenRadioButtonList @bind-Value="editIsSpendingAllowance" TValue="bool" Orientation="Orientation.Vertical" Gap="4px">
                            <Items>
                                <RadzenRadioButtonListItem Text="Scheduled transaction" Value="false" />
                                <RadzenRadioButtonListItem Text="Spending allowance" Value="true" />
                            </Items>
                        </RadzenRadioButtonList>
                        <small class="text-muted">Allowances are reduced by posted expenses in the selected category and never create a Checkbook transaction.</small>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Name:" Component="editBudgetNameTextBox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="editBudgetName" Name="editBudgetNameTextBox" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                @if (!editIsSpendingAllowance)
                {
                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Type:" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenRadioButtonList @bind-Value="editIsExpense" TValue="bool" Orientation="Orientation.Horizontal" Gap="10px">
                            <Items>
                                <RadzenRadioButtonListItem Text="Expense" Value="true" />
                                <RadzenRadioButtonListItem Text="Income" Value="false" />
                            </Items>
                        </RadzenRadioButtonList>
                    </RadzenColumn>
                </RadzenRow>
                }

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="@(editIsSpendingAllowance ? "Allowance:" : "Amount:")" Component="editAmountNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editAmount" TValue="decimal" Name="editAmountNumeric"
                                       Format="c2" Min="0" Step="0.01" Style="width: 120px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="@(editIsSpendingAllowance ? "Next Reset:" : "Due Date:")" Component="editNextDueDatePicker" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenDatePicker @bind-Value="editNextDueDate" Name="editNextDueDatePicker" DateFormat="MM/dd/yyyy" Style="width: 150px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Frequency:" Component="editFrequencyDropDown" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenDropDown @bind-Value="editFrequencyId" TValue="int" Name="editFrequencyDropDown"
                                        Data="@frequencyOptions" TextProperty="FrequencyName" ValueProperty="FrequencyId"
                                        Style="width: 180px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Category:" Component="editCategoryAutoComplete" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenAutoComplete @bind-Value="editCategory" Data="@categoriesList" Name="editCategoryAutoComplete"
                                            Placeholder="Type to search..." Style="width: 100%;"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                    </RadzenColumn>
                </RadzenRow>

                @if (!editIsSpendingAllowance)
                {
                <RadzenRow Gap="0.5rem" class="mb-2" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4" class="text-end">
                        <RadzenLabel Text="Is Bill:" Component="editIsBillCheckbox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenCheckBox @bind-Value="editIsBill" TValue="bool" Name="editIsBillCheckbox" />
                    </RadzenColumn>
                </RadzenRow>

                @if (editIsBill)
                {
                    <RadzenRow Gap="0.5rem" class="mb-2">
                        <RadzenColumn Size="4" class="text-end pt-2">
                            <RadzenLabel Text="Payee:" Component="editPayeeAutoComplete" />
                        </RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenAutoComplete @bind-Value="editPayee" Data="@payeesList" Name="editPayeeAutoComplete"
                                                Placeholder="Type to search..." Style="width: 100%;"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow Gap="0.5rem" class="mb-2" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4" class="text-end">
                            <RadzenLabel Text="Options:" />
                        </RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="15px">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5px">
                                    <RadzenCheckBox @bind-Value="editIsAuto" TValue="bool" Name="editIsAutoCheckbox" />
                                    <RadzenLabel Text="Auto" Component="editIsAutoCheckbox" Style="margin-bottom: 0;" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="5px">
                                    <RadzenCheckBox @bind-Value="editIsLate" TValue="bool" Name="editIsLateCheckbox" />
                                    <RadzenLabel Text="Late" Component="editIsLateCheckbox" Style="margin-bottom: 0;" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                }
                }

                <RadzenRow Gap="0.5rem" class="mb-2" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4" class="text-end">
                        <RadzenLabel Text="Has End Date:" Component="editHasEndDateCheckbox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenCheckBox @bind-Value="editHasEndDate" TValue="bool" Name="editHasEndDateCheckbox" />
                    </RadzenColumn>
                </RadzenRow>

                @if (editHasEndDate)
                {
                    <RadzenRow Gap="0.5rem" class="mb-2">
                        <RadzenColumn Size="4" class="text-end pt-2">
                            <RadzenLabel Text="End Date:" Component="editEndDatePicker" />
                        </RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenDatePicker @bind-Value="editEndDate" Name="editEndDatePicker" DateFormat="MM/dd/yyyy" Style="width: 150px;" />
                        </RadzenColumn>
                    </RadzenRow>
                }

                @if (editBudgetId != -1)
                {
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="12">
                            <RadzenButton Text="Delete this Budget" Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                          Click="DeleteBudgetAsync" />
                        </RadzenColumn>
                    </RadzenRow>
                }

                <RadzenRow>
                    <RadzenColumn Size="12" class="text-center">
                        <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="SaveBudgetAsync" class="me-2" />
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </div>
    }
}
