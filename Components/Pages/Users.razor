@page "/users"
@using ClintonFrankland.Models.Entities
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Users</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else if (!AuthService.CurrentUser.IsAdmin)
{
    <div class="alert alert-warning">
        <h4>Access Denied</h4>
        <p class="mb-0">Only administrators can access the Users page.</p>
    </div>
}
else
{
    @* Media queries for responsive column visibility - using Bootstrap breakpoints *@
    <RadzenMediaQuery Query="(max-width: 575.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraSmall, matches))" />
    <RadzenMediaQuery Query="(min-width: 576px) and (max-width: 767.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Small, matches))" />
    <RadzenMediaQuery Query="(min-width: 768px) and (max-width: 991.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Medium, matches))" />
    <RadzenMediaQuery Query="(min-width: 992px) and (max-width: 1199.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Large, matches))" />
    <RadzenMediaQuery Query="(min-width: 1200px) and (max-width: 1399.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraLarge, matches))" />
    <RadzenMediaQuery Query="(min-width: 1400px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraExtraLarge, matches))" />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="container mb-3">
        <div class="row align-items-center g-2">
            <div class="col-auto">
                <h1 class="mb-0">Users</h1>
            </div>
            <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                @if (AuthService.CurrentUser.IsAdmin)
                {
                    <button class="btn btn-primary" @onclick="ShowNewUser">+ New User</button>
                }
            </div>
        </div>
    </div>

    <div class="container mt-2">
        <RadzenDataGrid Data="@UsersList" TItem="User"
                        Density="Density.Compact"
                        AllowFiltering="true" AllowSorting="true" AllowPaging="true"
                        PageSize="25" PageSizeOptions="@(new int[] { 25, 50, 100 })"
                        ShowPagingSummary="true" PagingSummaryFormat="Showing {0} to {1} of {2} users"
                        FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="rz-datatable-striped">
            <Columns>
                @if (!AuthService.CurrentUser.ListButtonsRight)
                {
                    <RadzenDataGridColumn TItem="User" Width="@(IsAtLeast(ScreenSize.Small) ? "70px" : "75px")" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="u">
                            <div class="d-flex justify-content-start gap-2 flex-column flex-sm-row">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="() => EditUser(u)" title="Edit user" />
                                <RadzenButton Icon="key" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                              Click="() => OpenPasswordUtility(u)" title="Password utility" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="User" Property="UserId" Title="ID" Width="80px" />
                <RadzenDataGridColumn TItem="User" Property="DisplayName" Title="Full Name" />
                <RadzenDataGridColumn TItem="User" Property="UserName" Title="Username" />
                <RadzenDataGridColumn TItem="User" Property="EmailAddress" Title="Email" />
                <RadzenDataGridColumn TItem="User" Property="IsAdmin" Title="Admin" Width="100px">
                    <Template Context="u">
                        @(u.IsAdmin ? "Yes" : "No")
                    </Template>
                </RadzenDataGridColumn>
                @if (AuthService.CurrentUser.ListButtonsRight)
                {
                    <RadzenDataGridColumn TItem="User" Width="@(IsAtLeast(ScreenSize.Small) ? "70px" : "75px")" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="u">
                            <div class="d-flex justify-content-end gap-2 flex-column flex-sm-row">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              Click="() => EditUser(u)" title="Edit user" />
                                <RadzenButton Icon="key" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small"
                                              Click="() => OpenPasswordUtility(u)" title="Password utility" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </div>
}

@if (EditingUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);" @onclick="CloseEditModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((IsNewUser ? "New User" : "Edit User"))</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Full Name</label>
                        <input class="form-control" @bind="FormDisplayName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Username</label>
                        <input class="form-control" @bind="FormUserName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input class="form-control" @bind="FormEmail" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="isAdmin" @bind="FormIsAdmin" disabled="@(!AuthService.CurrentUser.IsAdmin)" />
                        <label class="form-check-label" for="isAdmin">Is Admin</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveUser">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@if (PasswordUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);" @onclick="ClosePasswordModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Password Utility - @PasswordUser.UserName</h5>
                    <button type="button" class="btn-close" @onclick="ClosePasswordModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">New Password</label>
                    <div class="input-group mb-2">
                        <input class="form-control" @bind="PasswordValue" />
                        <button class="btn btn-outline-secondary" @onclick="GeneratePassword">Generate</button>
                    </div>
                    <div class="form-text">Passwords are hashed with PBKDF2 + per-user salt.</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePasswordModal">Cancel</button>
                    <button class="btn btn-warning" @onclick="ResetPassword">Reset Password</button>
                </div>
            </div>
        </div>
    </div>
}
