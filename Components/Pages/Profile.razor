@page "/profile"
@rendermode InteractiveServer

<PageTitle>User Profile | It's a Budget</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    <h1 class="mb-3">My Profile</h1>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="card mb-3">
        <div class="card-header">Profile Details</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">Full Name</label>
                <input class="form-control" @bind="DisplayName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Username</label>
                <input class="form-control" @bind="UserName" />
            </div>
            <div class="mb-2">
                <label class="form-label">Email Address</label>
                <input class="form-control" @bind="EmailAddress" />
            </div>
            <div class="mb-2">
                <label class="form-label">List Buttons Location</label>
                <InputSelect class="form-select" @bind-Value="ListButtonsRight">
                    <option value="false">Left</option>
                    <option value="true">Right</option>
                </InputSelect>
                <div class="form-text">Controls placement on Checkbook, Budget Forecast, Budget Items, and Accounts list views.</div>
            </div>
            <button class="btn btn-primary" @onclick="SaveProfileAsync">Save Profile</button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Notification Preferences</div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="receiveBillDue" @bind="ReceiveBillDueNotices" />
                <label class="form-check-label" for="receiveBillDue">Receive bill-due notices</label>
                <div class="form-text">Get individual email reminders when bills are due. Requires a valid email address above.</div>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="receiveWeeklyDigest" @bind="ReceiveWeeklyUpcomingBillDigest" />
                <label class="form-check-label" for="receiveWeeklyDigest">Receive weekly upcoming bills digest</label>
                <div class="form-text">Get one Monday email with bills due in the next 7 days.</div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Timezone</label>
                    <InputSelect class="form-select" @bind-Value="NotificationTimezone">
                        @foreach (var tz in AvailableTimezones)
                        {
                            <option value="@tz.Id">@tz.DisplayName</option>
                        }
                    </InputSelect>
                    <div class="form-text">Your local timezone for scheduling notifications.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Preferred Delivery Time</label>
                    <input type="time" class="form-control" @bind="NotificationDeliveryTime" />
                    <div class="form-text">When you'd like to receive bill-due notices (in your local time).</div>
                </div>
            </div>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" @onclick="SaveNotificationPreferencesAsync">Save Notification Preferences</button>
                <button class="btn btn-outline-primary" @onclick="SendWeeklyDigestPreviewAsync" disabled="@IsSendingWeeklyPreview">
                    @(IsSendingWeeklyPreview ? "Sending..." : "Send Weekly Digest Preview")
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Authentik Account</div>
        <div class="card-body">
            @if (!IsAuthentikEnabled)
            {
                <div class="text-muted">Authentik linking is not enabled.</div>
            }
            else if (CurrentDbUser is null)
            {
                <div class="text-muted">Profile not loaded.</div>
            }
            else
            {
                <div class="mb-3">
                    <div class="fw-semibold">@ExternalIdentityStatus</div>
                    @if (HasExternalIdentity)
                    {
                        <div class="text-muted small">
                            @if (!string.IsNullOrWhiteSpace(CurrentDbUser.ExternalDisplayName))
                            {
                                <span>@CurrentDbUser.ExternalDisplayName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(CurrentDbUser.ExternalEmail))
                            {
                                <span>@(string.IsNullOrWhiteSpace(CurrentDbUser.ExternalDisplayName) ? "" : " - ")@CurrentDbUser.ExternalEmail</span>
                            }
                            @if (CurrentDbUser.LastExternalLoginUtc.HasValue)
                            {
                                <span> - Last sign-in @CurrentDbUser.LastExternalLoginUtc.Value.ToLocalTime().ToString("g")</span>
                            }
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (HasExternalIdentity)
                    {
                        <a class="btn btn-outline-primary" href="@AuthentikLinkUrl">Relink Authentik Account</a>
                        <button class="btn btn-outline-danger" @onclick="UnlinkAuthentikAsync">Unlink Authentik Account</button>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="@AuthentikLinkUrl">Link Authentik Account</a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">Reset Password</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label">New Password</label>
                <div class="input-group">
                    <input class="form-control" @bind="NewPassword" />
                    <button class="btn btn-outline-secondary" @onclick="GeneratePassword">Generate</button>
                </div>
            </div>
            <button class="btn btn-warning" @onclick="ResetPasswordAsync">Reset Password</button>
        </div>
    </div>
}
