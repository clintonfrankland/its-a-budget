@page "/insights"
@using ClintonFrankland.Models.ViewModels
@rendermode InteractiveServer

<PageTitle>Insights</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="container">
        <div class="row align-items-center gy-2">
            <div class="col-auto">
                <h1>Insights</h1>
            </div>
            <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                <label class="form-label mb-0 me-2" for="insightsMonth">Month</label>
                <input id="insightsMonth"
                       class="form-control d-inline-block"
                       style="width: 170px;"
                       type="month"
                       value="@SelectedMonthInput"
                       @onchange="OnSelectedMonthChangedAsync" />
            </div>
        </div>
    </div>

    <div class="container mt-3">
        <div class="alert alert-info py-2 mb-3">
            Showing expense spending for <strong>@SelectedMonthLabel</strong>.
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <RadzenCard class="h-100">
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">Spending by Category</RadzenText>
                    @if (categoryTotals.Count == 0)
                    {
                        <p class="text-muted mb-0">No expense transactions for this month yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Spent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in categoryTotals)
                                    {
                                        <tr>
                                            <td>@item.CategoryName</td>
                                            <td class="text-end">@item.Total.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </RadzenCard>
            </div>

            <div class="col-12 col-lg-6">
                <RadzenCard class="h-100">
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">Top Payees</RadzenText>
                    @if (topPayees.Count == 0)
                    {
                        <p class="text-muted mb-0">No payee spending to show for this month.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Payee</th>
                                        <th class="text-end">Transactions</th>
                                        <th class="text-end">Spent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in topPayees)
                                    {
                                        <tr>
                                            <td>@item.PayeeName</td>
                                            <td class="text-end">@item.TransactionCount</td>
                                            <td class="text-end">@item.Total.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </RadzenCard>
            </div>

            <div class="col-12">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">Category Trend</RadzenText>
                    @if (categoryTrends.Count == 0)
                    {
                        <p class="text-muted mb-0">No expense transactions in the recent trend window.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        @foreach (var month in trendMonths)
                                        {
                                            <th class="text-end">@month.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var trend in categoryTrends)
                                    {
                                        <tr>
                                            <td>@trend.CategoryName</td>
                                            @foreach (var total in trend.MonthlyTotals)
                                            {
                                                <td class="text-end">@total.ToString("C")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </RadzenCard>
            </div>
        </div>
    </div>
}

