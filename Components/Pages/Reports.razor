@page "/reports"
@using ClintonFrankland.Models.ViewModels
@rendermode InteractiveServer

<PageTitle>Reports</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p aria-live="polite">Redirecting to login...</p>
}
else
{
    <div class="container">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
            <h1 class="mb-0">Reports</h1>
            <div class="d-flex flex-wrap gap-3">
                <div><label class="form-label" for="reportMonth">Reporting month</label><input id="reportMonth" class="form-control" type="month" value="@SelectedMonthInput" @onchange="OnMonthChanged" /></div>
                <div><label class="form-label" for="forecastHorizon">Cashflow horizon</label><select id="forecastHorizon" class="form-select" value="@horizonDays" @onchange="OnHorizonChanged"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option><option value="180">180 days</option></select></div>
            </div>
        </div>

        @if (loading) { <div class="placeholder-glow mt-3" aria-live="polite"><span class="placeholder col-12"></span><span class="visually-hidden">Loading reports</span></div> }
        <div class="row g-3 mt-1">
            <div class="col-12 col-xl-6"><RadzenCard class="h-100"><h2 class="h5">Spend vs Plan</h2>
                @if (!string.IsNullOrEmpty(spendError)) { <div class="alert alert-warning" role="alert">@spendError</div> }
                else if (spendPlan.Count == 0) { <p class="text-muted">No plans or spending for this month.</p> }
                else { <div class="table-responsive"><table class="table table-sm"><caption class="visually-hidden">Monthly planned and actual spending by category</caption><thead><tr><th>Category</th><th class="text-end">Plan</th><th class="text-end">Actual</th><th class="text-end">Variance</th><th>Status</th></tr></thead><tbody>
                    @foreach (var row in spendPlan) { <tr><td>@row.CategoryName</td><td class="text-end">@row.Planned.ToString("C")</td><td class="text-end">@row.Actual.ToString("C")</td><td class="text-end">@row.Variance.ToString("C")</td><td>@row.Status</td></tr> }
                    <tr class="fw-bold"><td>Total</td><td class="text-end">@spendPlan.Sum(x => x.Planned).ToString("C")</td><td class="text-end">@spendPlan.Sum(x => x.Actual).ToString("C")</td><td class="text-end">@spendPlan.Sum(x => x.Variance).ToString("C")</td><td></td></tr>
                </tbody></table></div> }
            </RadzenCard></div>
            <div class="col-12 col-xl-6"><RadzenCard class="h-100"><h2 class="h5">Cashflow Forecast</h2>
                @if (!string.IsNullOrEmpty(cashflowError)) { <div class="alert alert-warning" role="alert">@cashflowError</div> }
                else if (cashflow is not null) { <p>Starting <strong>@cashflow.StartingBalance.ToString("C")</strong> as of @cashflow.StartDate.ToString("MM/dd/yyyy"). Lowest: <strong>@cashflow.LowestBalance.ToString("C")</strong> on @cashflow.LowestDate.ToString("MM/dd/yyyy").</p><div class="table-responsive"><table class="table table-sm"><caption class="visually-hidden">Posted starting balance and future projected recurring items</caption><thead><tr><th>Date</th><th>Item</th><th class="text-end">Change</th><th class="text-end">Balance</th></tr></thead><tbody>@foreach (var point in cashflow.Points) { <tr><td>@point.Date.ToString("MM/dd/yyyy")</td><td>@point.Description</td><td class="text-end">@(point.IsStartingBalance ? "—" : point.Change.ToString("C"))</td><td class="text-end">@point.Balance.ToString("C")</td></tr> }</tbody></table></div> }
            </RadzenCard></div>
            <div class="col-12"><RadzenCard><h2 class="h5">Category Trends</h2>
                @if (!string.IsNullOrEmpty(trendError)) { <div class="alert alert-warning" role="alert">@trendError</div> }
                else if (trends.Count == 0) { <p class="text-muted">No expense spending in this seven-month window.</p> }
                else { <div class="table-responsive"><table class="table table-sm"><caption class="visually-hidden">Seven-month expense trends by category</caption><thead><tr><th>Category</th>@foreach (var month in months) { <th class="text-end">@month.Label</th> }</tr></thead><tbody>@foreach (var row in trends) { <tr><td>@row.CategoryName</td>@foreach (var value in row.MonthlyTotals) { <td class="text-end">@value.ToString("C")</td> }</tr> }</tbody></table></div> }
            </RadzenCard></div>
            <div class="col-12"><RadzenCard><h2 class="h5">Net Worth</h2>
                @if (!string.IsNullOrEmpty(netWorthError)) { <div class="alert alert-warning" role="alert">@netWorthError</div> }
                else if (netWorth is not null) { <p>Current total as of @netWorth.CurrentAsOfDate.ToString("MM/dd/yyyy"): <strong>@netWorth.CurrentTotal.ToString("C")</strong></p><div class="table-responsive"><table class="table table-sm"><caption class="visually-hidden">Seven month-end net worth values</caption><thead><tr>@foreach (var point in netWorth.History) { <th class="text-end">@point.Date.ToString("MMM yyyy")</th> }</tr></thead><tbody><tr>@foreach (var point in netWorth.History) { <td class="text-end">@point.Value.ToString("C")</td> }</tr></tbody></table></div> }
            </RadzenCard></div>
        </div>
    </div>
}
