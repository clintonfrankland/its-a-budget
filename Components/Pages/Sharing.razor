@page "/sharing"
@using ClintonFrankland.Models.Entities
@rendermode InteractiveServer

<PageTitle>Budget Sharing</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    <h1 class="mb-3">Budget Sharing</h1>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (BudgetOptions.Count == 0)
    {
        <div class="alert alert-info">Your private budget is ready. Sharing options appear here after your budget membership is created.</div>
    }
    else
    {
        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-end mb-3">
            <div class="flex-grow-1">
                <label class="form-label">Shared Budget</label>
                @if (BudgetOptions.Count > 1)
                {
                    <select class="form-select" value="@SelectedSharedBudgetId" @onchange="SelectBudgetAsync">
                        @foreach (var budget in BudgetOptions)
                        {
                            <option value="@budget.SharedBudgetId">@budget.Name</option>
                        }
                    </select>
                }
                else
                {
                    <div class="form-control-plaintext fw-semibold">@SelectedBudget?.Name</div>
                }
            </div>
            @if (SelectedBudget is not null)
            {
                <div class="text-muted">
                    @SelectedBudget.Role access - @SelectedBudget.ActiveMemberCount active member@(SelectedBudget.ActiveMemberCount == 1 ? "" : "s")
                </div>
            }
            @if (SelectedBudget is not null && !IsSelectedBudgetOwner)
            {
                <button class="btn btn-outline-danger" @onclick="LeaveBudgetAsync">Leave Budget</button>
            }
        </div>

        @if (IsPrivateSingleUserBudget)
        {
            <div class="alert alert-light border">
                This budget is private right now. Invite someone when you are ready to share access.
            </div>
        }

        @if (!CanManageSelectedBudget)
        {
            <div class="alert alert-info">Your role can use this budget, but only Owners and Admins can manage members and invites.</div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header">Create Invite</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Email or Username</label>
                            <input class="form-control" @bind="InviteTarget" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Role</label>
                            <InputSelect class="form-select" @bind-Value="InviteRole">
                                <option value="@BudgetMemberRole.Viewer">Viewer</option>
                                <option value="@BudgetMemberRole.Editor">Editor</option>
                                <option value="@BudgetMemberRole.Admin">Admin</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-3 d-grid align-items-end">
                            <button class="btn btn-primary mt-md-4" @onclick="CreateInviteAsync">Create Invite</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(LastInviteLink))
            {
                <div class="alert alert-info">
                    <div class="fw-semibold">Invite link</div>
                    <code class="sharing-invite-link">@LastInviteLink</code>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header">Members</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle sharing-management-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Username</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Members)
                                {
                                    var isCurrentUser = member.UserId == CurrentUserContext.UserId;
                                    var canEditMember = !isCurrentUser && member.Role != BudgetMemberRole.Owner;
                                    <tr>
                                        <td>@(member.User?.DisplayName ?? "Unknown user")</td>
                                        <td>@(member.User?.UserName ?? "")</td>
                                        <td>
                                            @if (canEditMember)
                                            {
                                                <select class="form-select form-select-sm sharing-role-select"
                                                        value="@MemberRoleSelections[member.BudgetMemberId]"
                                                        @onchange="args => SetMemberRoleSelection(member.BudgetMemberId, args)">
                                                    <option value="@BudgetMemberRole.Viewer">Viewer</option>
                                                    <option value="@BudgetMemberRole.Editor">Editor</option>
                                                    <option value="@BudgetMemberRole.Admin">Admin</option>
                                                </select>
                                            }
                                            else
                                            {
                                                @member.Role
                                            }
                                        </td>
                                        <td>@member.Status</td>
                                        <td class="text-end">
                                            @if (canEditMember)
                                            {
                                                <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => ChangeMemberRoleAsync(member.BudgetMemberId)">Update</button>
                                                @if (IsSelectedBudgetOwner)
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => TransferOwnershipAsync(member.BudgetMemberId)">Make Owner</button>
                                                }
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveMemberAsync(member.BudgetMemberId)">Remove</button>
                                            }
                                            else if (isCurrentUser && !IsSelectedBudgetOwner)
                                            {
                                                <button class="btn btn-outline-danger btn-sm" @onclick="LeaveBudgetAsync">Leave</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Pending Invites</div>
                <div class="card-body">
                    @if (Invites.Count == 0)
                    {
                        <div class="text-muted">No invites yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle sharing-management-table">
                                <thead>
                                    <tr>
                                        <th>Target</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Expires</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invite in Invites)
                                    {
                                        <tr>
                                            <td>@invite.Target</td>
                                            <td>@invite.Role</td>
                                            <td>@InviteStatus(invite)</td>
                                            <td>@invite.ExpiresAtUtc.ToLocalTime().ToString("g")</td>
                                            <td class="text-end">
                                                @if (!invite.AcceptedAtUtc.HasValue && !invite.RevokedAtUtc.HasValue)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => ResendInviteAsync(invite.BudgetInviteId)">Resend</button>
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeInviteAsync(invite.BudgetInviteId)">Revoke</button>
                                                }
                                                else if (!invite.AcceptedAtUtc.HasValue)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => ResendInviteAsync(invite.BudgetInviteId)">Resend</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
}
