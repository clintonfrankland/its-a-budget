@page "/transaction-rules"
@rendermode InteractiveServer
@using ClintonFrankland.Models.Entities
@using ClintonFrankland.Models.ViewModels
@using ClintonFrankland.Services
@inject AuthService AuthService
@inject CurrentUserContext CurrentUser
@inject TransactionRulesDataService Rules
@inject NavigationManager Navigation

<PageTitle>Transaction Rules | It's a Budget</PageTitle>
@if (!AuthService.IsAuthenticated) { <p>Redirecting to login...</p> }
else { <div class="container mt-3"><h1>Transaction Rules</h1>
<p class="text-muted">Rules run from top to bottom. Amounts are signed: expenses are negative and income is positive.</p>
@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }
<RadzenCard class="mb-3"><h5>@(editingId is null ? "New rule" : "Edit rule")</h5>
<RadzenTextBox @bind-Value="contains" Placeholder="Text to find in payee or notes" Style="width:100%" />
<RadzenDropDown @bind-Value="accountId" Data="accounts" TextProperty="AccountName" ValueProperty="AccountId" TValue="int?" AllowClear="true" Placeholder="All accounts" Style="width:100%" class="mt-2" />
<div class="row mt-2"><div class="col"><RadzenNumeric @bind-Value="min" TValue="decimal?" Placeholder="Minimum signed amount" /></div><div class="col"><RadzenNumeric @bind-Value="max" TValue="decimal?" Placeholder="Maximum signed amount" /></div></div>
<div class="row mt-2"><div class="col"><RadzenDropDown @bind-Value="category" Data="categories" TValue="string" AllowClear="true" Placeholder="Set category" Style="width:100%" /></div><div class="col"><RadzenDropDown @bind-Value="payee" Data="payees" TValue="string" AllowClear="true" Placeholder="Set payee" Style="width:100%" /></div></div>
<RadzenTextArea @bind-Value="notes" Placeholder="Set notes" Rows="2" Style="width:100%" class="mt-2" />
<RadzenCheckBox @bind-Value="enabled" TValue="bool" /> <span>Enabled</span>
<RadzenButton Text="Save rule" Click="Save" class="ms-2" /> <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="Reset" class="ms-2" />
</RadzenCard>
<RadzenCard><h5>Priority (first match wins)</h5>
@foreach (var r in rules) { <div class="border-bottom py-2 d-flex align-items-center gap-2"><span class="flex-grow-1"><strong>@r.ContainsText</strong> @AccountFilter(r) → @Outputs(r) @(!r.IsEnabled ? "(disabled)" : "") @if (r.Source == TransactionRuleSource.Learned) { <small class="text-muted">Learned: @r.EvidenceSummary (@((r.Confidence ?? 0m).ToString("P0")))</small> }</span><RadzenButton Icon="keyboard_arrow_up" Size="ButtonSize.Small" Click="@(() => Move(r, -1))" /><RadzenButton Icon="keyboard_arrow_down" Size="ButtonSize.Small" Click="@(() => Move(r, 1))" /><RadzenButton Text="Edit" Size="ButtonSize.Small" Click="@(() => Edit(r))" /><RadzenButton Text="@(r.IsEnabled ? "Disable" : "Enable")" Size="ButtonSize.Small" Click="@(() => Toggle(r))" /><RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => Delete(r.TransactionRuleId))" /></div> }
</RadzenCard>
<RadzenCard class="mt-3"><h5>Learn from cleared Plaid history</h5><p class="text-muted">Suggestions require at least three confirmed, cleared examples and 80% agreement. Saving is always your decision; rules only suggest values in the inbox.</p><RadzenButton Text="Find suggestions" Click="LoadLearned" />
@if (learned.Count > 0) { @foreach (var proposal in learned) { <div class="border-top py-2"><strong>@proposal.MerchantLabel</strong> → @proposal.PayeeName / @proposal.CategoryName <span class="text-muted">@proposal.EvidenceSummary Confidence: @proposal.Confidence.ToString("P0")</span><ul>@foreach (var example in proposal.Examples) { <li>@example</li> }</ul><RadzenButton Text="Save and remember" Size="ButtonSize.Small" Click="@(() => SaveLearned(proposal))" /><RadzenButton Text="Reject" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => RejectLearned(proposal))" class="ms-2" /></div> } } else if (learnedLoaded) { <p class="text-muted">No sufficiently consistent history yet.</p> }</RadzenCard>
<RadzenCard class="mt-3"><h5>Preview existing transactions</h5><RadzenButton Text="Preview" Click="Preview" /> @if (preview.Count > 0) { <RadzenButton Text="Apply previewed changes" ButtonStyle="ButtonStyle.Warning" Click="Apply" class="ms-2" /> <ul class="mt-2">@foreach (var p in preview) { <li>#@p.TransactionId (@string.Join(", ", p.ChangedFields)):<ul>@if (p.ChangedFields.Contains("Payee")) { <li>Payee: @p.CurrentPayee → @p.NewPayee</li> }@if (p.ChangedFields.Contains("Category")) { <li>Category: @p.CurrentCategory → @p.NewCategory</li> }@if (p.ChangedFields.Contains("Notes")) { <li>Notes: @(p.CurrentNotes ?? "(none)") → @(p.NewNotes ?? "(none)")</li> }</ul></li> }</ul> } else { <span class="ms-2 text-muted">No transactions would change.</span> }</RadzenCard>
</div> }

@code {
 private List<TransactionRule> rules = []; private List<TransactionRulePreviewItem> preview = []; private List<LearnedTransactionRuleProposal> learned = []; private bool learnedLoaded; private List<Account> accounts = []; private List<string> categories = []; private List<string> payees = []; private string? error; private int? editingId; private string contains = ""; private int? accountId; private decimal? min; private decimal? max; private string? category; private string? payee; private string? notes; private bool enabled = true;
 protected override async Task OnAfterRenderAsync(bool first) { if (!first) return; await AuthService.InitializeAsync(); if (!AuthService.IsAuthenticated) { Navigation.NavigateTo("/login?Return=%2Ftransaction-rules"); return; } await Load(); StateHasChanged(); }
 private async Task Load() { rules = await Rules.GetRulesAsync(CurrentUser.UserId); accounts = await Rules.GetOwnedAccountsAsync(CurrentUser.UserId); categories = await Rules.GetOwnedCategoryNamesAsync(CurrentUser.UserId); payees = await Rules.GetOwnedPayeeNamesAsync(CurrentUser.UserId); }
 private async Task Save() { try { await Rules.SaveAsync(CurrentUser.UserId, new(editingId, contains, accountId, min, max, category, payee, notes, enabled)); Reset(); await Load(); } catch (Exception ex) { error = ex.Message; } }
 private void Edit(TransactionRule r) { editingId=r.TransactionRuleId; contains=r.ContainsText; accountId=r.AccountId; min=r.MinimumAmount; max=r.MaximumAmount; category=r.CategoryName; payee=r.PayeeName; notes=r.Notes; enabled=r.IsEnabled; }
 private void Reset() { editingId=null; contains=""; accountId=null; min=max=null; category=payee=notes=null; enabled=true; error=null; }
 private async Task Delete(int id) { await Rules.DeleteAsync(CurrentUser.UserId, id); await Load(); }
 private async Task Toggle(TransactionRule rule) { await Rules.SaveAsync(CurrentUser.UserId, new(rule.TransactionRuleId, rule.ContainsText, rule.AccountId, rule.MinimumAmount, rule.MaximumAmount, rule.CategoryName, rule.PayeeName, rule.Notes, !rule.IsEnabled)); await Load(); }
 private async Task Move(TransactionRule r, int delta) { var ids=rules.Select(x=>x.TransactionRuleId).ToList(); var i=ids.IndexOf(r.TransactionRuleId); var target=i+delta; if(target<0||target>=ids.Count)return; (ids[i],ids[target])=(ids[target],ids[i]); await Rules.ReorderAsync(CurrentUser.UserId,ids); await Load(); }
 private async Task Preview() { preview=await Rules.PreviewAsync(CurrentUser.UserId); }
 private async Task Apply() { await Rules.ApplyAsync(CurrentUser.UserId, preview.Select(p=>p.TransactionId).ToArray()); await Preview(); }
 private async Task LoadLearned() { learned = await Rules.GetLearnedProposalsAsync(CurrentUser.UserId); learnedLoaded = true; }
 private async Task SaveLearned(LearnedTransactionRuleProposal proposal) { await Rules.SaveLearnedProposalAsync(CurrentUser.UserId, proposal); await Load(); await LoadLearned(); }
 private async Task RejectLearned(LearnedTransactionRuleProposal proposal) { await Rules.RejectProposalAsync(CurrentUser.UserId, proposal); await LoadLearned(); }
 private string AccountFilter(TransactionRule r) => r.AccountId is null ? "(all accounts)" : $"({accounts.FirstOrDefault(a => a.AccountId == r.AccountId)?.AccountName ?? "unavailable account"})";
 private static string Outputs(TransactionRule r) => string.Join(", ", new[] { r.CategoryName is null ? null : $"category: {r.CategoryName}", r.PayeeName is null ? null : $"payee: {r.PayeeName}", r.Notes is null ? null : "notes" }.Where(x => x is not null));
}
