@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

<PageTitle>Server Settings</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else if (!AuthService.CurrentUser.IsAdmin)
{
    <div class="alert alert-warning">
        <h4>Access Denied</h4>
        <p class="mb-0">Only administrators can access Server Settings.</p>
    </div>
}
else
{
    <h1 class="mb-3">Server Settings</h1>

    <div class="mb-3">
        <a href="/profile" class="btn btn-outline-secondary btn-sm">Go to My Profile</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert @MessageCss">@Message</div>
    }

    <div class="card">
        <div class="card-header fw-semibold">SMTP Email</div>
        <div class="card-body">
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="smtpEnabled" checked="@IsEnabled" @onchange="OnEnabledChanged" />
                <label class="form-check-label" for="smtpEnabled">Enable SMTP</label>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Host</label>
                    <input class="form-control" value="@Host" @onchange="OnHostChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Port</label>
                    <input type="number" class="form-control" value="@Port" @onchange="OnPortChanged" min="1" max="65535" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sender Email</label>
                    <input class="form-control" value="@SenderEmail" @onchange="OnSenderChanged" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    <input class="form-control" value="@UserName" @onchange="OnUsernameChanged" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Password</label>
                    <input class="form-control" value="@Password" @onchange="OnPasswordChanged" />
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="PersistAsync">Save SMTP Settings</button>
                <button class="btn btn-outline-primary" @onclick="SendTestAsync">Send Test Email</button>
            </div>
        </div>
    </div>
}
