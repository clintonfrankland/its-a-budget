@page "/settings"
@using ClintonFrankland.Components.Admin
@using ClintonFrankland.Models.Entities
@rendermode InteractiveServer

<PageTitle>Server Settings</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    <div class="container-fluid">
        <div class="row">
            @* Main content area *@
            <div class="col-lg-9 col-md-8">
                <h1 class="mb-4">@(AuthService.CurrentUser.IsAdmin ? "Server Settings" : "Account Settings")</h1>

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="alert @MessageCss alert-dismissible fade show">
                        @Message
                        <button type="button" class="btn-close" @onclick="() => Message = null"></button>
                    </div>
                }

                @if (AuthService.CurrentUser.IsAdmin)
                {
                    <MigrationDiagnosticsCard />
                }

                @* SMTP Email Section *@
                @if (AuthService.CurrentUser.IsAdmin)
                {
                <section id="smtp-email" class="mb-5">
                    <div class="card">
                        <div class="card-header fw-semibold">
                            <RadzenIcon Icon="email" class="me-2" />SMTP Email (Server-wide)
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                These settings are used by the server to send automated notices.
                                SMTP credentials (host/username/password) come from server configuration (environment variables), not per-user settings.
                            </p>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="smtpEnabled" checked="@IsEnabled" @onchange="OnEnabledChanged" />
                                <label class="form-check-label" for="smtpEnabled">Enable SMTP notices</label>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Server Host (read-only)</label>
                                    <input class="form-control" value="@ServerHostDisplay" readonly />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Server Port (read-only)</label>
                                    <input class="form-control" value="@ServerPortDisplay" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Server Username (read-only)</label>
                                    <input class="form-control" value="@ServerUserDisplay" readonly />
                                    <div class="form-text">Password is never shown here.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Sender Email</label>
                                    <input class="form-control" value="@SenderEmail" @onchange="OnSenderChanged" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">From Name (optional)</label>
                                    <input class="form-control" value="@FromName" @onchange="OnFromNameChanged" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">TLS Mode</label>
                                    <select class="form-select" value="@TlsMode" @onchange="OnTlsModeChanged">
                                        <option value="StartTls">STARTTLS (recommended)</option>
                                        <option value="SslOnConnect">SSL/TLS on connect (often port 465)</option>
                                        <option value="None">None (not recommended)</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="allowBadCerts" checked="@AllowInvalidCerts" @onchange="OnAllowInvalidCertsChanged" />
                                        <label class="form-check-label" for="allowBadCerts">Allow invalid TLS certificates</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Test Recipient Email (optional)</label>
                                    <input class="form-control" value="@TestRecipientEmail" @onchange="OnTestRecipientChanged" />
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2">
                                <button class="btn btn-primary" @onclick="PersistSmtpAsync">Save Settings</button>
                                <button class="btn btn-outline-primary" @onclick="SendTestAsync" disabled="@IsSendingTest">
                                    @if (IsSendingTest)
                                    {
                                        <span>Sending...</span>
                                    }
                                    else
                                    {
                                        <span>Send Test Email</span>
                                    }
                                </button>
                                @if (ShowTestLog)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="ClearTestLog" disabled="@IsSendingTest">Clear Log</button>
                                }
                            </div>

                            @if (ShowTestLog)
                            {
                                <div class="mt-3">
                                    <div class="card">
                                        <div class="card-header fw-semibold">Test Email Log</div>
                                        <div class="card-body" style="max-height: 200px; overflow:auto; background:#0b0f14; color:#e6edf3;">
                                            <pre class="mb-0" style="white-space:pre-wrap;">@string.Join("\n", TestLogLines)</pre>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
                }

                @* Bill Due Notifications *@
                @if (AuthService.CurrentUser.IsAdmin)
                {
                <section id="bill-due" class="mb-5">
                    <div class="card">
                        <div class="card-header fw-semibold">
                            <RadzenIcon Icon="notifications" class="me-2" />Bill-due Email Notifications
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                Server-wide switches for bill-due reminders. Users must also opt-in on their Profile page.
                            </p>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="billDueEnabled" checked="@BillDueIsEnabled" @onchange="OnBillDueEnabledChanged" />
                                <label class="form-check-label" for="billDueEnabled">Enable bill-due email reminders</label>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Due Soon Window (days ahead)</label>
                                    <input class="form-control" type="number" min="0" max="60" value="@BillDueSoonDays" @onchange="OnBillDueSoonDaysChanged" />
                                    <div class="form-text">Example: 3 means reminders for bills due within the next 3 days.</div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="pastDueEnabled" checked="@BillPastDueEnabled" @onchange="OnBillPastDueEnabledChanged" />
                                        <label class="form-check-label" for="pastDueEnabled">Send past-due reminders</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Past Due Max (days)</label>
                                    <input class="form-control" type="number" min="0" max="365" value="@BillPastDueMaxDays" @onchange="OnBillPastDueMaxDaysChanged" />
                                    <div class="form-text">Safety cap to avoid reminding forever.</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="PersistBillDueAsync">Save Settings</button>
                            </div>
                        </div>
                    </div>
                </section>
                }

                @* Users Section *@
                <section id="users" class="mb-5">
                    <div class="card">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span><RadzenIcon Icon="people" class="me-2" />Users</span>
                            @if (AuthService.CurrentUser.IsAdmin)
                            {
                                <button class="btn btn-primary btn-sm" @onclick="ShowNewUser">
                                    <RadzenIcon Icon="add" /> New User
                                </button>
                            }
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(UserErrorMessage))
                            {
                                <div class="alert alert-danger">@UserErrorMessage</div>
                            }

                            <RadzenDataGrid Data="@UsersList" TItem="User"
                                            Density="Density.Compact"
                                            AllowFiltering="true" AllowSorting="true" AllowPaging="true"
                                            PageSize="10" PageSizeOptions="@(new int[] { 10, 25, 50 })"
                                            ShowPagingSummary="true" PagingSummaryFormat="Showing {0} to {1} of {2} users"
                                            FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            class="rz-datatable-striped">
                                <Columns>
                                    @if (!AuthService.CurrentUser.ListButtonsRight)
                                    {
                                        <RadzenDataGridColumn TItem="User" Width="190px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                            <Template Context="u">
                                                <div class="d-flex justify-content-start gap-1">
                                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                                  Click="() => EditUser(u)" title="Edit user" />
                                                    @if (AuthService.CurrentUser.IsAdmin)
                                                    {
                                                        <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.ExtraSmall"
                                                                      Click="() => OpenExternalIdentityModal(u)" title="Link or relink Authentik identity" />
                                                        @if (HasExternalIdentity(u))
                                                        {
                                                            <RadzenButton Icon="link_off" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                                                          Click="() => UnlinkExternalIdentity(u)" title="Unlink Authentik identity" />
                                                        }
                                                    }
                                                    @if (HasExternalIdentity(u))
                                                    {
                                                        <span class="badge bg-secondary" title="Password utility is local-account-only">Local password disabled</span>
                                                    }
                                                    else
                                                    {
                                                        <RadzenButton Icon="key" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall"
                                                                      Click="() => OpenPasswordUtility(u)" title="Password utility" />
                                                    }
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    }
                                    <RadzenDataGridColumn TItem="User" Property="UserId" Title="ID" Width="60px" />
                                    <RadzenDataGridColumn TItem="User" Property="DisplayName" Title="Full Name" />
                                    <RadzenDataGridColumn TItem="User" Property="UserName" Title="Username" />
                                    <RadzenDataGridColumn TItem="User" Property="EmailAddress" Title="Email" />
                                    <RadzenDataGridColumn TItem="User" Title="Authentik Identity" Width="280px">
                                        <Template Context="u">
                                            <div class="small">
                                                <div class="fw-semibold">@ExternalIdentityStatus(u)</div>
                                                <div class="text-muted">@ExternalIdentitySubjectStatus(u)</div>
                                                <div>@ExternalIdentityMetadata(u)</div>
                                                <div class="text-muted">Last external login: @LastExternalLoginText(u)</div>
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="User" Property="IsAdmin" Title="Admin" Width="80px">
                                        <Template Context="u">
                                            @(u.IsAdmin ? "Yes" : "No")
                                        </Template>
                                    </RadzenDataGridColumn>
                                    @if (AuthService.CurrentUser.ListButtonsRight)
                                    {
                                        <RadzenDataGridColumn TItem="User" Width="190px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                                            <Template Context="u">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                                  Click="() => EditUser(u)" title="Edit user" />
                                                    @if (AuthService.CurrentUser.IsAdmin)
                                                    {
                                                        <RadzenButton Icon="link" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.ExtraSmall"
                                                                      Click="() => OpenExternalIdentityModal(u)" title="Link or relink Authentik identity" />
                                                        @if (HasExternalIdentity(u))
                                                        {
                                                            <RadzenButton Icon="link_off" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall"
                                                                          Click="() => UnlinkExternalIdentity(u)" title="Unlink Authentik identity" />
                                                        }
                                                    }
                                                    @if (HasExternalIdentity(u))
                                                    {
                                                        <span class="badge bg-secondary" title="Password utility is local-account-only">Local password disabled</span>
                                                    }
                                                    else
                                                    {
                                                        <RadzenButton Icon="key" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall"
                                                                      Click="() => OpenPasswordUtility(u)" title="Password utility" />
                                                    }
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    }
                                </Columns>
                            </RadzenDataGrid>
                        </div>
                    </div>
                </section>
            </div>

            @* Right-side navigation *@
            @if (AuthService.CurrentUser.IsAdmin)
            {
            <div class="col-lg-3 col-md-4 d-none d-md-block">
                <div class="position-sticky" style="top: 80px;">
                    <div class="card">
                        <div class="card-header fw-semibold">
                            <RadzenIcon Icon="menu" class="me-2" />Sections
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="#smtp-email" @onclick="ScrollToSmtpEmail" @onclick:preventDefault 
                               class="list-group-item list-group-item-action d-flex align-items-center">
                                <RadzenIcon Icon="email" class="me-2" /> SMTP Email
                            </a>
                            <a href="#bill-due" @onclick="ScrollToBillDue" @onclick:preventDefault
                               class="list-group-item list-group-item-action d-flex align-items-center">
                                <RadzenIcon Icon="notifications" class="me-2" /> Bill-due Notifications
                            </a>
                            <a href="#users" @onclick="ScrollToUsers" @onclick:preventDefault 
                               class="list-group-item list-group-item-action d-flex align-items-center">
                                <RadzenIcon Icon="people" class="me-2" /> Users
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
}

@* User Edit Modal *@
@if (EditingUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);" @onclick="CloseEditModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((IsNewUser ? "New User" : "Edit User"))</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Full Name</label>
                        <input class="form-control" @bind="FormDisplayName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Username</label>
                        <input class="form-control" @bind="FormUserName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input class="form-control" @bind="FormEmail" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="isAdmin" @bind="FormIsAdmin" disabled="@(!AuthService.CurrentUser.IsAdmin)" />
                        <label class="form-check-label" for="isAdmin">Is Admin</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveUser">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@* Authentik Identity Modal *@
@if (LinkUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);" @onclick="CloseExternalIdentityModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Authentik Identity - @LinkUser.UserName</h5>
                    <button type="button" class="btn-close" @onclick="CloseExternalIdentityModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        Link the Budget user to the stable Authentik subject claim. Email and display name are shown only for audit context.
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Provider</label>
                        <input class="form-control" @bind="LinkProvider" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Subject</label>
                        <input class="form-control" @bind="LinkSubject" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">External Email</label>
                        <input class="form-control" @bind="LinkEmail" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">External Display Name</label>
                        <input class="form-control" @bind="LinkDisplayName" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseExternalIdentityModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveExternalIdentity">
                        @(HasExternalIdentity(LinkUser) ? "Relink Authentik Identity" : "Link Authentik Identity")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Password Utility Modal *@
@if (PasswordUser is not null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);" @onclick="ClosePasswordModal">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Password Utility - @PasswordUser.UserName</h5>
                    <button type="button" class="btn-close" @onclick="ClosePasswordModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">New Password</label>
                    <div class="input-group mb-2">
                        <input class="form-control" @bind="PasswordValue" />
                        <button class="btn btn-outline-secondary" @onclick="GeneratePassword">Generate</button>
                    </div>
                    <div class="form-text">Passwords are hashed with PBKDF2 + per-user salt.</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePasswordModal">Cancel</button>
                    <button class="btn btn-warning" @onclick="ResetPassword">Reset Password</button>
                </div>
            </div>
        </div>
    </div>
}
