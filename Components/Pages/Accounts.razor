@page "/accounts"
@using System.Data
@rendermode InteractiveServer

<PageTitle>Accounts | It's a Budget</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <p>Redirecting to login...</p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (currentView == ViewMode.List)
    {
        @* Media queries for responsive column visibility - using Bootstrap breakpoints *@
        <RadzenMediaQuery Query="(max-width: 575.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraSmall, matches))" />
        <RadzenMediaQuery Query="(min-width: 576px) and (max-width: 767.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Small, matches))" />
        <RadzenMediaQuery Query="(min-width: 768px) and (max-width: 991.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Medium, matches))" />
        <RadzenMediaQuery Query="(min-width: 992px) and (max-width: 1199.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.Large, matches))" />
        <RadzenMediaQuery Query="(min-width: 1200px) and (max-width: 1399.98px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraLarge, matches))" />
        <RadzenMediaQuery Query="(min-width: 1400px)" Change="@(matches => OnScreenSizeChange(ScreenSize.ExtraExtraLarge, matches))" />

        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto">
                    <h1>Accounts</h1>
                    @if (!string.IsNullOrWhiteSpace(activeBudgetName))
                    {
                        <div class="text-muted">@activeBudgetName</div>
                    }
                </div>
                <div class="col @(AuthService.CurrentUser.ListButtonsRight ? "text-end" : "text-start")">
                    @if (canCreateFinancialData)
                    {
                        <RadzenButton Icon="add" Text="@(IsAtLeast(ScreenSize.Medium) ? "Add Account" : "")" ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Medium" Click="ShowAddAccount" />
                    }
                    <RadzenButton Icon="account_balance" Text="@(IsAtLeast(ScreenSize.Medium) ? "Bank connections" : "")" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Medium" class="ms-2" Click="ShowPlaidConnections" />
                </div>
            </div>
        </div>

        <div class="container mt-4">
            <RadzenDataGrid @ref="accountsGrid" Data="@filteredAccounts" TItem="AccountViewModel"
                            Density="Density.Compact"
                            AllowFiltering="true" AllowSorting="true"
                            FilterMode="FilterMode.CheckBoxList" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            class="rz-datatable-striped">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" class="mb-2">
                        <RadzenTextBox @bind-Value="@searchText" Placeholder="Search..."
                                       Style="width: 250px;"
                                       @oninput="@(args => OnSearch(args.Value?.ToString()))" />
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <RadzenButton Icon="clear" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => OnSearch(string.Empty))" title="Clear search" />
                        }
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    @if (!AuthService.CurrentUser.ListButtonsRight && filteredAccounts.Any(a => a.CanManageFinancialData))
                    {
                        <RadzenDataGridColumn TItem="AccountViewModel" Title="" Width="90px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @if (item.CanManageFinancialData)
                                {
                                    @if (!item.IsDefault)
                                    {
                                        <RadzenButton Icon="star" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Click="() => MakeDefaultAccountAsync(item.AccountId)" title="Make default" aria-label="Make default account" class="me-1" />
                                    }
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="() => ShowEditAccountAsync(item.AccountId)" title="Edit" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    <RadzenDataGridColumn TItem="AccountViewModel" Property="AccountName" Title="Account Name" SortOrder="SortOrder.Ascending">
                        <Template Context="item">
                            @item.AccountName
                            @if (item.IsDefault)
                            {
                                <span class="badge text-bg-primary ms-2">Default</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="AccountType" Title="Type" Width="120px" Visible="@IsAtLeast(ScreenSize.Medium)" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="LastUpdated" Title="Last Upd" Width="100px" Visible="@IsAtLeast(ScreenSize.Large)" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="AccountNumber" Title="Acct#" Width="100px" Visible="@IsAtLeast(ScreenSize.ExtraLarge)" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="InterestRate" Title="Interest" Width="80px" FormatString="{0:0.##}%" TextAlign="TextAlign.Right" Visible="@IsAtLeast(ScreenSize.Large)" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="MinimumPayment" Title="Payment" Width="100px" FormatString="{0:C}" TextAlign="TextAlign.Right" Visible="@IsAtLeast(ScreenSize.Medium)" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="Balance" Title="Balance" Width="110px" FormatString="{0:C}" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="AccountViewModel" Property="Ratio" Title="Ratio" Width="70px" TextAlign="TextAlign.Right" Visible="@IsAtLeast(ScreenSize.Large)">
                        <Template Context="item">
                            @(item.Ratio.HasValue ? $"{item.Ratio:0.##}" : "")
                        </Template>
                    </RadzenDataGridColumn>

                    @if (AuthService.CurrentUser.ListButtonsRight && filteredAccounts.Any(a => a.CanManageFinancialData))
                    {
                        <RadzenDataGridColumn TItem="AccountViewModel" Title="" Width="90px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @if (item.CanManageFinancialData)
                                {
                                    @if (!item.IsDefault)
                                    {
                                        <RadzenButton Icon="star" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                      Click="() => MakeDefaultAccountAsync(item.AccountId)" title="Make default" aria-label="Make default account" class="me-1" />
                                    }
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="() => ShowEditAccountAsync(item.AccountId)" title="Edit" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </div>
    }
    else if (currentView == ViewMode.Edit)
    {
        <div class="container" style="max-width: 550px;">
            <RadzenCard class="mt-3">
                <h4 class="mb-3">@(editAccountId == -1 ? "Add" : "Edit") Account</h4>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Name:" Component="editAccountNameTextBox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="editAccountName" Name="editAccountNameTextBox"
                                       MaxLength="255" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Account #:" Component="editAccountNumberTextBox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="editAccountNumber" Name="editAccountNumberTextBox"
                                       MaxLength="16" Style="width: 150px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Type:" Component="editAccountTypeDropDown" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenDropDown @bind-Value="editAccountType" TValue="int" Name="editAccountTypeDropDown"
                                        Data="@accountTypeOptions" TextProperty="Name" ValueProperty="Id"
                                        Style="width: 180px;" />
                    </RadzenColumn>
                </RadzenRow>

                @if (editAccountId == -1)
                {
                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Opening Balance:" Component="editBalanceNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editBalance" TValue="decimal" Name="editBalanceNumeric"
                                       Format="c2" Step="0.01" Style="width: 130px;" />
                    </RadzenColumn>
                </RadzenRow>
                }
                else
                {
                    <RadzenRow Gap="0.5rem" class="mb-2">
                        <RadzenColumn Size="4" class="text-end pt-2">Opening Balance:</RadzenColumn>
                        <RadzenColumn Size="8">
                            <strong>@FormatPresentedAccountBalance(currentOpeningBalance)</strong>
                            <RadzenButton Text="Adjust" Icon="tune" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light" class="ms-2"
                                          Click="ShowAdjustOpeningBalanceAsync" />
                        </RadzenColumn>
                    </RadzenRow>
                }

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Credit Limit:" Component="editCreditLimitNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editCreditLimit" TValue="decimal" Name="editCreditLimitNumeric"
                                       Format="c2" Step="0.01" Style="width: 130px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Available:" Component="editAvailableCreditNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editAvailableCredit" TValue="decimal" Name="editAvailableCreditNumeric"
                                       Format="c2" Step="0.01" Style="width: 130px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Due Day:" Component="editDueDateNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editDueDate" TValue="int" Name="editDueDateNumeric"
                                       Min="1" Max="31" Step="1" Style="width: 80px;" />
                        <span class="text-muted ms-2" style="font-size: 0.875rem;">(day of month)</span>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Min Payment:" Component="editMinimumPaymentNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editMinimumPayment" TValue="decimal" Name="editMinimumPaymentNumeric"
                                       Format="c2" Step="0.01" Style="width: 130px;" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-2">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Interest:" Component="editInterestRateNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenNumeric @bind-Value="editInterestRate" TValue="decimal" Name="editInterestRateNumeric"
                                       Format="0.##" Step="0.01" Style="width: 80px;" />
                        <span class="text-muted ms-2" style="font-size: 0.875rem;">%</span>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="0.5rem" class="mb-3">
                    <RadzenColumn Size="4" class="text-end pt-2">
                        <RadzenLabel Text="Web URL:" Component="editWebUrlTextBox" />
                    </RadzenColumn>
                    <RadzenColumn Size="8">
                        <RadzenTextBox @bind-Value="editWebUrl" Name="editWebUrlTextBox"
                                       MaxLength="1024" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                @if (editAccountId != -1)
                {
                    <RadzenRow class="mb-3">
                        <RadzenColumn Size="12">
                            <RadzenButton Text="Delete this Account" Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                          Click="DeleteAccountAsync" />
                        </RadzenColumn>
                    </RadzenRow>
                }

                <RadzenRow>
                    <RadzenColumn Size="12" class="text-center">
                        <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="SaveAccountAsync" class="me-2" />
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </div>
    }
    else if (currentView == ViewMode.AdjustOpeningBalance)
    {
        <div class="container" style="max-width: 550px;">
            <RadzenCard class="mt-3">
                <h4 class="mb-3">Adjust Opening Balance</h4>
                <div class="alert alert-warning">
                    Changing the opening balance changes the account's current balance, cleared balance,
                    forecast, and Safe to Spend. No transactions will be changed.
                </div>
                <RadzenRow Gap="0.5rem" class="mb-3">
                    <RadzenColumn Size="5" class="text-end pt-2">
                        <RadzenLabel Text="New Opening Balance:" Component="proposedOpeningBalanceNumeric" />
                    </RadzenColumn>
                    <RadzenColumn Size="7">
                        <RadzenNumeric @bind-Value="proposedOpeningBalance" TValue="decimal"
                                       Name="proposedOpeningBalanceNumeric" Format="c2" Step="0.01"
                                       Style="width: 150px;" Change="@(_ => PreviewOpeningBalanceAsync())" />
                    </RadzenColumn>
                </RadzenRow>
                @if (balanceAdjustmentPreview is not null)
                {
                    <div class="border rounded p-3 mb-3">
                        <div>Opening balance: <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.CurrentOpeningBalance)</strong> → <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.ProposedOpeningBalance)</strong></div>
                        <div>Current balance: <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.CurrentBalance)</strong> → <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.ProposedBalance)</strong></div>
                        <div>Cleared balance: <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.CurrentClearedBalance)</strong> → <strong>@FormatPresentedAccountBalance(balanceAdjustmentPreview.ProposedClearedBalance)</strong></div>
                    </div>
                }
                <div class="text-center">
                    <RadzenButton Text="Adjust Opening Balance" ButtonStyle="ButtonStyle.Danger"
                                  Click="SaveOpeningBalanceAdjustmentAsync" class="me-2" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelOpeningBalanceAdjustment" />
                </div>
            </RadzenCard>
        </div>
    }
}
