@page "/"
@rendermode InteractiveServer

<PageTitle>It's a Budget | Plan ahead. Stay in control.</PageTitle>
<HeadContent>
    <meta name="description" content="It's a Budget is a practical, checkbook-first way to track spending, plan upcoming bills, and understand the balance ahead." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="It's a Budget" />
    <meta property="og:description" content="Your money, finally in one place. Plan ahead, track honestly, and stay in control." />
    <meta property="og:image" content="/images/brand/its-a-budget-social.png" />
    <meta property="og:url" content="https://budget.clintandtara.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://budget.clintandtara.com/" />
</HeadContent>

@if (AuthService.IsAuthenticated)
{
    <div class="landing-hero">
        <div class="container py-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="images/brand/its-a-budget-mark.png" alt="" class="hero-logo" />
                        <h1 class="display-5 fw-semibold mb-0">Your money, finally in one place</h1>
                    </div>
                    <p class="lead text-muted mb-4">
                        It's a Budget is a practical, checkbook-first way to stay on top of your spending, plan for upcoming bills,
                        and see your balance before life surprises you.
                    </p>
                    <h2 class="h3 mb-1">At a glance</h2>
                    <p class="text-muted mb-4">A quick snapshot so you can make decisions fast.</p>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="snapshot-card">
                                <div class="snapshot-label">Today's balance</div>
                                <div class="snapshot-value">@(Snapshot?.TodayBalance.ToString("C") ?? "...")</div>
                                <div class="snapshot-sub text-muted">As of @DateTime.Today.ToString("ddd, MMM d")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="snapshot-card">
                                <div class="snapshot-label">Upcoming bills (7 days)</div>
                                <div class="snapshot-value">@(Snapshot?.UpcomingBillsTotal.ToString("C") ?? "...")</div>
                                <div class="snapshot-sub text-muted">Bills due soon or past due</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="snapshot-card">
                                <div class="snapshot-label">Safe-to-spend (Lowest bal)</div>
                                <div class="snapshot-value @(Snapshot?.LowestProjectedBalance < 0 ? "text-danger" : "")">
                                    @(Snapshot?.LowestProjectedBalance.ToString("C") ?? "...")
                                </div>
                                <div class="snapshot-sub text-muted">
                                    @if (Snapshot is not null)
                                    {
                                        @:On @Snapshot.LowestProjectedBalanceDate.ToString("MMM d")
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Snapshot?.CategorySpend is { Count: > 0 })
    {
        const int pageSize = 8;
        var visible = _showAllCategories ? Snapshot.CategorySpend : Snapshot.CategorySpend.Take(pageSize).ToList();
        var maxSpend = Snapshot.CategorySpend.Max(c => c.HasAllowance ? c.AllowanceSpent ?? 0m : c.Total);
        <div class="container py-2 pb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h5 mb-0">Spending in @DateTime.Today.ToString("MMMM")</h3>
                        <a class="btn btn-sm btn-outline-secondary" href="/checkbook">View checkbook</a>
                    </div>
                    <div class="row g-2">
                        @foreach (var cat in visible)
                        {
                            var displayedSpend = cat.HasAllowance ? cat.AllowanceSpent ?? 0m : cat.Total;
                            var pct = cat.HasAllowance && cat.AllowancePlanned > 0m
                                ? (int)Math.Min(100m, displayedSpend / cat.AllowancePlanned.Value * 100m)
                                : maxSpend > 0m ? (int)(displayedSpend / maxSpend * 100m) : 0;
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="category-spend-card">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="category-spend-name">@cat.CategoryName</div>
                                        @if (cat.HasAllowance && cat.AllowanceRemaining < 0m)
                                        {
                                            <span class="badge text-bg-danger">Over</span>
                                        }
                                    </div>
                                    <div class="category-spend-amount">
                                        @if (cat.HasAllowance)
                                        {
                                            <strong class="@(cat.AllowanceRemaining < 0m ? "text-danger" : null)">@cat.AllowanceRemaining!.Value.ToString("C0") left</strong>
                                            <span class="category-budget-slash"> · @cat.AllowanceSpent!.Value.ToString("C0") of @cat.AllowancePlanned!.Value.ToString("C0") spent</span>
                                        }
                                        else
                                        {
                                            @cat.Total.ToString("C0") <span class="category-budget-slash">spent this month</span>
                                        }
                                    </div>
                                    @if (cat.AllowanceResetDate.HasValue)
                                    {
                                        <div class="small text-muted">Resets @cat.AllowanceResetDate.Value.ToString("MMM d")</div>
                                    }
                                    <div class="category-spend-bar-track">
                                        <div class="category-spend-bar" style="width: @(pct)%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Snapshot.CategorySpend.Count > pageSize)
                    {
                        <div class="text-center mt-3">
                            <button class="btn btn-sm btn-link text-muted" @onclick="() => _showAllCategories = !_showAllCategories">
                                @(_showAllCategories ? "Show less" : $"Show {Snapshot.CategorySpend.Count - pageSize} more…")
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(SnapshotError))
                    {
                        <div class="alert alert-warning">Dashboard snapshot unavailable: @SnapshotError</div>
                    }
                </div>

                @* Right column: Welcome back card *@
                <div class="col-lg-4">
                    <div class="card shadow-sm sticky-top" style="top: 80px;">
                        <div class="card-body p-4">
                            <h2 class="h4 mb-2">Welcome back, @AuthService.CurrentUser.DisplayName</h2>
                            <p class="text-muted mb-3">
                                Jump straight to your ledger, forecast, or budget items.
                            </p>
                            <div class="d-grid gap-2">
                                <a class="btn btn-primary" href="/checkbook">Open Checkbook</a>
                                <a class="btn btn-outline-primary" href="/budget">Forecast</a>
                                <a class="btn btn-outline-primary" href="/budgetitems">Budget Items</a>
                                <a class="btn btn-outline-primary" href="/accounts">Accounts</a>
                                <a class="btn btn-outline-secondary" href="/profile">Profile &amp; Notifications</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container py-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="h5 mb-0">Upcoming bills</h3>
                    <a class="btn btn-sm btn-outline-secondary" href="/budgetitems">View all</a>
                </div>

                @if (Snapshot?.UpcomingBills is null || Snapshot.UpcomingBills.Count == 0)
                {
                    <p class="text-muted mb-0">No upcoming bills found in the next 14 days.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Due</th>
                                    <th>Bill</th>
                                    <th>Payee</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Snapshot.UpcomingBills)
                                {
                                    <tr class="@(b.IsPastDue ? "bill-row-pastdue" : "")">
                                        <td style="white-space:nowrap;">
                                            @b.DueDate.ToString("MMM d")
                                            @if (b.IsPastDue)
                                            {
                                                <span class="badge text-bg-danger ms-2 fw-normal">Overdue</span>
                                            }
                                        </td>
                                        <td>@b.Name</td>
                                        <td class="text-muted">@b.Payee</td>
                                        <td class="text-end">@b.Amount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="landing-hero">
        <div class="container py-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="images/brand/its-a-budget-mark.png" alt="" class="hero-logo" />
                        <div>
                            <div class="brand-eyebrow">IT'S A BUDGET</div>
                            <h1 class="display-5 fw-semibold mb-0">Your money, finally in one place</h1>
                        </div>
                    </div>
                    <p class="lead text-muted mb-4">
                        It's a Budget is a practical, checkbook-first way to stay on top of your spending, plan for upcoming bills,
                        and see your balance before life surprises you.
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="feature-pill">
                                <div class="feature-title">Checkbook ledger</div>
                                <div class="feature-sub">Track transactions with a running balance that stays honest.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-pill">
                                <div class="feature-title">Budget forecast</div>
                                <div class="feature-sub">Project your balance forward so upcoming bills are visible.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-pill">
                                <div class="feature-title">Bank connections</div>
                                <div class="feature-sub">Review eligible transactions from Plaid before they affect your checkbook.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-pill">
                                <div class="feature-title">Shared budgets</div>
                                <div class="feature-sub">Plan together with explicit household membership and role-based access.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-brand btn-lg" href="/login">Sign in securely</a>
                        <a class="btn btn-outline-secondary btn-lg" href="#features">See what you get</a>
                        <a class="btn btn-outline-secondary btn-lg" href="#how-it-works">How it works</a>
                    </div>
                </div>

                <div class="col-lg-5">
                    <RadzenCard class="login-card-landing">
                        <div class="login-header">
                            <RadzenIcon Icon="lock" Style="font-size: 44px; color: var(--rz-primary);" />
                            <h2 class="h4 mt-2 mb-1">Sign in</h2>
                            <p class="text-muted mb-0">Go straight to your Checkbook after login.</p>
                        </div>

                        @if (IsAuthentikEnabled)
                        {
                            <a class="btn btn-primary btn-lg authentik-login-button" href="@AuthentikLoginUrl">
                                <i class="fa fa-shield-alt"></i>&nbsp;&nbsp;Sign in with Authentik
                            </a>

                            <div class="fallback-divider">
                                <span>Local fallback</span>
                            </div>
                        }

                        @if (ShowWarning)
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                                         AllowClose="false" class="mb-3">
                                Invalid username or password.
                            </RadzenAlert>
                        }

                        <EditForm Model="LoginModel" OnValidSubmit="HandleLogin" FormName="landingLoginForm">
                            <div class="mb-3">
                                <RadzenLabel Text="Username" Component="landingUsername" class="d-block mb-1" />
                                <RadzenTextBox @bind-Value="LoginModel.Username" Name="landingUsername"
                                               Placeholder="Enter your username"
                                               Style="width: 100%;" AutoComplete="true" />
                            </div>

                            <div class="mb-3">
                                <RadzenLabel Text="Password" Component="landingPassword" class="d-block mb-1" />
                                <RadzenPassword @bind-Value="LoginModel.Password" Name="landingPassword"
                                                Placeholder="Enter your password" Style="width: 100%;" />
                            </div>

                            <RadzenButton ButtonType="ButtonType.Submit" Text="Sign In"
                                          ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                          Style="width: 100%;" Icon="login" />
                        </EditForm>

                        <div class="mt-3 small text-muted">
                            Your financial information stays behind your account. Read the <a href="/privacy">Privacy Policy</a> to learn how It's a Budget handles data.
                        </div>
                    </RadzenCard>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div id="features" class="row g-4">
            <div class="col-12">
                <h2 class="h3 mb-1">What this app helps you do</h2>
                <p class="text-muted mb-0">Simple, practical features you'll actually use.</p>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Stay grounded with a ledger</h3>
                        <p class="text-muted mb-0">
                            Enter real transactions, keep a running balance, and quickly see what cleared versus what is still pending.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Plan ahead with Budget Forecast</h3>
                        <p class="text-muted mb-0">
                            Forecast upcoming bills and income so you can spot the pinch points before they happen.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Keep a clean bill list</h3>
                        <p class="text-muted mb-0">
                            Manage recurring budget items in one place. Mark bills as bills so reminders and forecasts behave correctly.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Optional bill-due reminders</h3>
                        <p class="text-muted mb-0">
                            If enabled by an admin and you opt-in, the server can email you when bills are due soon or past due.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Designed for real life</h3>
                        <p class="text-muted mb-0">
                            Fast pages, clear navigation, and fewer "dashboard gimmicks". The goal is control, not noise.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">Self-host friendly</h3>
                        <p class="text-muted mb-0">
                            Built as a focused application with clear access controls, explicit review steps, and practical exports and backups.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div id="how-it-works" class="row mt-5">
            <div class="col-lg-10">
                <h2 class="h3">A simple flow that works</h2>
                <ol class="text-muted">
                    <li><strong>Create Budget Items</strong> for scheduled bills, income, and category spending allowances.</li>
                    <li><strong>Enter transactions</strong> in Checkbook as life happens.</li>
                    <li><strong>Use Budget Forecast</strong> when you want to see what's coming.</li>
                    <li><strong>Review connected transactions</strong> when you choose to link an eligible bank through Plaid.</li>
                    <li><strong>Turn on reminders</strong> (optional) so you do less remembering and more living.</li>
                </ol>
            </div>
        </div>
    </div>
}

<style>
    .landing-hero {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.03), rgba(15, 23, 42, 0.00));
        border-bottom: 1px solid rgba(0,0,0,0.06);
        padding-top: 20px;
        margin-top: 10px;
    }

    .hero-logo {
        width: 120px;
        height: 120px;
        object-fit: contain;
    }

    .feature-pill {
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 12px;
        padding: 14px 16px;
        background: #fff;
        height: 100%;
    }

    .feature-title {
        font-weight: 650;
        margin-bottom: 4px;
    }

    .feature-sub {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.35;
    }

    .login-card-landing {
        padding: 26px;
        border-radius: 14px;
        border: 1px solid var(--rz-border-color);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.10);
    }

    .authentik-login-button {
        width: 100%;
        border-radius: 8px;
        font-weight: 600;
        padding: 12px;
        margin-bottom: 18px;
    }

    .fallback-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--rz-text-secondary-color);
        font-size: 0.85rem;
        margin-bottom: 18px;
    }

    .fallback-divider::before,
    .fallback-divider::after {
        content: "";
        height: 1px;
        flex: 1;
        background: var(--rz-border-color);
    }

    .snapshot-card {
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 14px;
        padding: 16px;
        background: #fff;
        height: 100%;
    }

    .snapshot-label {
        color: #6c757d;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 6px;
    }

    .snapshot-value {
        font-size: 1.6rem;
        font-weight: 750;
        letter-spacing: -0.02em;
    }

    .snapshot-sub {
        margin-top: 4px;
        font-size: 0.85rem;
    }

    .category-spend-card {
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 10px;
        padding: 12px 14px;
        background: #fff;
        height: 100%;
    }

    .category-spend-name {
        font-size: 0.78rem;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .category-spend-amount {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .category-spend-bar-track {
        height: 3px;
        background: rgba(0,0,0,0.07);
        border-radius: 2px;
        margin-top: 8px;
    }

    .category-spend-bar {
        height: 3px;
        background: var(--bs-primary);
        border-radius: 2px;
    }

    .category-star {
        color: gold;
        font-size: 0.95rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .category-budget-slash {
        font-size: 0.85rem;
        font-weight: 500;
        color: #6c757d;
    }

    .bill-row-pastdue td:first-child {
        border-left: 3px solid var(--bs-danger);
        padding-left: calc(0.5rem - 3px);
    }

    .login-header {
        text-align: center;
        margin-bottom: 18px;
    }

    .login-card-landing .rz-textbox,
    .login-card-landing .rz-password {
        border-radius: 10px;
    }

    .login-card-landing .rz-button {
        border-radius: 10px;
        font-weight: 650;
        padding: 12px;
    }
</style>
