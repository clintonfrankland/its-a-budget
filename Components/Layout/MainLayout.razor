@inherits LayoutComponentBase
@implements IDisposable

<RadzenComponents @rendermode="InteractiveAuto" />
<nav class="navbar navbar-expand-lg navbar-dark fixed-top brand-navbar">
    <div class="container-fluid">
        <a class="navbar-brand brand-lockup" href="/" @onclick="CollapseNavbar" aria-label="It's a Budget home">
            <img src="images/brand/its-a-budget-48.png" alt="" class="brand-navbar-mark" />
            <span>@SiteInfoService.SiteInfo.SiteName</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="navbar" class="collapse navbar-collapse">
            @if (AuthService.IsAuthenticated)
            {
                <ul class="navbar-nav me-auto app-primary-nav">
                    <li class="nav-item"><a class="nav-link" href="/checkbook" @onclick="NavigateToCheckbook" @onclick:preventDefault="true">Checkbook</a></li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Plan</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/budget" @onclick="CollapseNavbar"><strong class="d-block">Forecast</strong><small class="d-block text-secondary mt-1">Projected balances and upcoming items</small></a></li>
                            <li><a class="dropdown-item" href="/budgetitems" @onclick="CollapseNavbar"><strong class="d-block">Budget Items</strong><small class="d-block text-secondary mt-1">Scheduled transactions and spending allowances</small></a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/reports" @onclick="CollapseNavbar">Reports</a></li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/accounts" @onclick="CollapseNavbar"><strong class="d-block">Accounts</strong><small class="d-block text-secondary mt-1">Balances and account details</small></a></li>
                            <li><a class="dropdown-item" href="/payees" @onclick="CollapseNavbar"><strong class="d-block">Payees</strong><small class="d-block text-secondary mt-1">Names and duplicate cleanup</small></a></li>
                            <li><a class="dropdown-item" href="/transaction-rules" @onclick="CollapseNavbar"><strong class="d-block">Transaction Rules</strong><small class="d-block text-secondary mt-1">Automatic categorization</small></a></li>
                            <li><a class="dropdown-item" href="/sharing" @onclick="CollapseNavbar"><strong class="d-block">Sharing</strong><small class="d-block text-secondary mt-1">Members and invitations</small></a></li>
                        </ul>
                    </li>
                </ul>
            }
            <ul class="nav ms-auto">
                @if (AuthService.IsAuthenticated)
                {
                    @if (_budgetSwitcherOptions.Count > 0)
                    {
                        <li class="nav-item d-flex align-items-center me-xl-2 my-1 my-xl-0">
                            <select class="form-select form-select-sm budget-switcher" title="Active budget" aria-label="Active budget" value="@_selectedSwitcherBudgetId" @onchange="HandleBudgetSwitcherChange">
                                @foreach (var budget in _budgetSwitcherOptions)
                                {
                                    <option value="@budget.SharedBudgetId">@budget.Name</option>
                                }
                            </select>
                        </li>
                    }
                    <li class="nav-item dropdown user-menu">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-user"></i>&nbsp;@AuthService.CurrentUser.DisplayName
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/onboarding" @onclick="CollapseNavbar">Setup guide</a></li>
                            <li><a class="dropdown-item" href="/profile" @onclick="CollapseNavbar">Profile &amp; Notifications</a></li>
                            @if (AuthService.CurrentUser.IsAdmin)
                            {
                                <li><a class="dropdown-item" href="/settings" @onclick="CollapseNavbar">Settings</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="#" @onclick="HandleLogoutClick" @onclick:preventDefault="true"><i class="fa fa-sign-out-alt"></i>&nbsp;Logout</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/login" @onclick="CollapseNavbar">
                            <i class="fa fa-sign-in-alt"></i>&nbsp;&nbsp;Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<div class="container">
    @if (AuthService.IsAuthenticated && AuthService.CurrentUser.IsAdmin && StartupDiagnostics.Checked && StartupDiagnostics.HasIssue)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <h5 class="mb-1">Startup database diagnostics</h5>
            <div><strong>Failure type:</strong> @StartupDiagnostics.FailureType</div>
            <div><strong>Details:</strong> @StartupDiagnostics.ErrorMessage</div>
            <div><strong>Last applied migration:</strong> @(StartupDiagnostics.LastAppliedMigration ?? "(none found)")</div>
            <div class="mt-2"><strong>Safe next steps:</strong></div>
            <ul class="mb-0">
                @foreach (var step in StartupDiagnostics.SafeSteps)
                {
                    <li>@step</li>
                }
            </ul>
        </div>
    }

    @Body
    <hr />
    <footer class="site-footer">
        <div>
            <strong>@SiteInfoService.SiteInfo.SiteName</strong>
            <small class="text-muted">v@(SiteInfoService.SiteInfo.Version)</small>
        </div>
        <nav aria-label="Legal and support">
            <a href="/about">About</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/security">Security</a>
            <a href="/data-deletion">Data deletion</a>
            <a href="/contact">Contact</a>
        </nav>
        <p class="small text-muted mb-0">&copy; @DateTime.Now.Year @SiteInfoService.SiteInfo.SiteName</p>
    </footer>
</div>
