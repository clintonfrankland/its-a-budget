@inherits LayoutComponentBase
@implements IDisposable

<RadzenComponents @rendermode="InteractiveAuto" />
<nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/" @onclick="CollapseNavbar">
            <i class="@GetIconClass()"></i>&nbsp;@SiteInfoService.SiteInfo.SiteName
        </a>
        <button class="navbar-toggler" type="button" @onclick="ToggleNavbar" @onclick:stopPropagation="true">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="navbar" class="navbar-collapse @NavbarCollapseClass">
            @if (AuthService.IsAuthenticated)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="checkbook" @onclick="CollapseNavbar">Checkbook</a></li>
                    <li class="nav-item"><a class="nav-link" href="budget" @onclick="CollapseNavbar">Budget Forecast</a></li>
                    <li class="nav-item"><a class="nav-link" href="budgetitems" @onclick="CollapseNavbar">Budget Items</a></li>
                    <li class="nav-item"><a class="nav-link" href="accounts" @onclick="CollapseNavbar">Accounts</a></li>
                    @if (AuthService.CurrentUser.IsAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" href="settings" @onclick="CollapseNavbar">Settings</a></li>
                    }
                </ul>
            }
            <ul class="nav ms-auto">
                @if (AuthService.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/profile" @onclick="CollapseNavbar">
                            <i class="fa fa-user"></i>&nbsp;&nbsp;@AuthService.CurrentUser.DisplayName
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" @onclick="HandleLogoutClick" @onclick:preventDefault="true">
                            <i class="fa fa-sign-out-alt"></i>&nbsp;&nbsp;Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/login" @onclick="CollapseNavbar">
                            <i class="fa fa-sign-in-alt"></i>&nbsp;&nbsp;Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@* Overlay to detect clicks outside navbar when expanded *@
@if (_navbarExpanded)
{
    <div class="navbar-overlay" @onclick="CollapseNavbar"></div>
}

<div class="container" @onclick="CollapseNavbar">
    @Body
    <hr />
    <footer>
        <p>&copy; @DateTime.Now.Year - @SiteInfoService.SiteInfo.SiteName <small class="text-muted">(@SiteInfoService.SiteInfo.Version)</small></p>
    </footer>
</div>


